.hero {
  position: relative;
  overflow: hidden;
  padding: 34rpx 30rpx 0;
  border: 1rpx solid rgba(21, 39, 31, 0.09);
  border-radius: 40rpx;
  background:
    radial-gradient(circle at 82% 55%, rgba(217, 239, 124, 0.52), transparent 330rpx),
    linear-gradient(135deg, #fffdf7 0%, #f4f4e6 100%);
  box-shadow: 0 8rpx 24rpx rgba(21, 39, 31, 0.04);
}

.hero-eyebrow {
  display: flex;
  align-items: center;
  color: #1b4b37;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.spark {
  display: flex;
  width: 39rpx;
  height: 39rpx;
  align-items: center;
  justify-content: center;
  margin-right: 10rpx;
  border: 1rpx solid rgba(27, 75, 55, 0.14);
  border-radius: 50%;
  background: #eef7c8;
  font-size: 18rpx;
  letter-spacing: 0;
}

.greeting {
  margin-top: 26rpx;
  color: #70786f;
  font-size: 21rpx;
  font-weight: 600;
}

.hero-title {
  margin-top: 8rpx;
  font-size: 76rpx;
  font-weight: 700;
  line-height: 1.03;
  letter-spacing: -5rpx;
}

.hero-title-line {
  display: block;
}

.accent {
  color: #1b4b37;
  border-bottom: 7rpx solid #ed6b4c;
}

.hero-copy {
  max-width: 580rpx;
  margin-top: 22rpx;
  color: #31473b;
  font-size: 24rpx;
  line-height: 1.78;
}

.hero-actions {
  display: flex;
  margin-top: 28rpx;
}

.hero-btn {
  flex: 1;
  padding: 0 12rpx;
  font-size: 25rpx;
}

.hero-btn + .hero-btn {
  margin-left: 12rpx;
}

.btn-icon {
  margin-right: 7rpx;
  font-size: 26rpx;
}

.btn-hover {
  opacity: 0.88;
  transform: translateY(1rpx);
}

.hero-sub {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
}

.hero-link {
  color: #31473b;
  font-size: 21rpx;
  font-weight: 600;
  border-bottom: 1rpx solid rgba(21, 39, 31, 0.24);
}

.chev {
  margin-left: 3rpx;
  font-size: 21rpx;
}

.privacy {
  color: #8d948d;
  font-size: 18rpx;
}

.hero-visual {
  position: relative;
  display: flex;
  height: 404rpx;
  align-items: center;
  justify-content: center;
  margin-top: 8rpx;
}

.hero-disc {
  position: absolute;
  width: 366rpx;
  height: 366rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #d9ef7c, #c4df62);
  box-shadow: 0 20rpx 50rpx rgba(116, 139, 45, 0.14);
}

.hero-image {
  position: relative;
  z-index: 2;
  width: 302rpx;
  height: 302rpx;
  border: 10rpx solid rgba(255, 253, 247, 0.76);
  border-radius: 50%;
  box-shadow: 0 22rpx 50rpx rgba(21, 39, 31, 0.18);
}

.float {
  position: absolute;
  z-index: 3;
  border: 1rpx solid rgba(21, 39, 31, 0.08);
  border-radius: 18rpx;
  background: rgba(255, 253, 247, 0.94);
  box-shadow: 0 10rpx 26rpx rgba(21, 39, 31, 0.1);
}

.float-kcal {
  top: 34rpx;
  left: 4rpx;
  display: flex;
  width: 104rpx;
  height: 96rpx;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  color: #d9ef7c;
  background: #15271f;
}

.float-big {
  display: block;
  font-family: Georgia, "Songti SC", serif;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.1;
}

.float-kcal .float-big {
  font-size: 42rpx;
}

.float-small {
  display: block;
  margin-top: 2rpx;
  color: #70786f;
  font-size: 16rpx;
  line-height: 1.2;
}

.float-kcal .float-small {
  color: rgba(255, 253, 247, 0.55);
  font-size: 14rpx;
  letter-spacing: 1rpx;
}

.float-ai {
  top: 24rpx;
  right: 10rpx;
  padding: 12rpx 17rpx;
  font-size: 18rpx;
  font-weight: 600;
}

.float-dot {
  display: inline-block;
  width: 11rpx;
  height: 11rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #6e9b53;
}

.float-protein {
  bottom: 44rpx;
  left: 4rpx;
  display: flex;
  align-items: center;
  padding: 12rpx 18rpx 12rpx 12rpx;
}

.leaf {
  display: flex;
  width: 43rpx;
  height: 43rpx;
  align-items: center;
  justify-content: center;
  margin-right: 9rpx;
  color: #1b4b37;
  border-radius: 14rpx;
  background: #eef7c8;
  font-size: 27rpx;
}

.today-card {
  margin-top: 22rpx;
  padding: 30rpx 28rpx 24rpx;
}

.card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.today-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
}

.today-numbers {
  min-width: 0;
}

.label {
  color: #70786f;
  font-size: 20rpx;
  font-weight: 600;
}

.big-num {
  margin-top: 4rpx;
  font-family: Georgia, "Songti SC", serif;
  font-size: 86rpx;
  font-weight: 600;
  line-height: 1;
  letter-spacing: -4rpx;
}

.big-unit {
  margin-left: 6rpx;
  color: #70786f;
  font-family: -apple-system, sans-serif;
  font-size: 18rpx;
  letter-spacing: 0;
}

.sub-line {
  margin-top: 10rpx;
  color: #70786f;
  font-size: 19rpx;
}

.sub-line.over {
  color: #ed6b4c;
}

.meta-row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  color: #8d948d;
  font-size: 18rpx;
}

.meta-row text {
  margin-right: 8rpx;
}

.goal-chip {
  padding: 3rpx 12rpx;
  color: #1b4b37 !important;
  border: 1rpx solid rgba(27, 75, 55, 0.14);
  border-radius: 999rpx;
  background: #eef7c8;
  font-size: 17rpx;
  font-weight: 700;
}

.today-ring {
  flex: none;
  margin-left: 8rpx;
}

.ring-num {
  font-family: Georgia, "Songti SC", serif;
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1;
}

.ring-unit {
  margin-left: 2rpx;
  color: #70786f;
  font-size: 19rpx;
}

.ring-cap {
  margin-top: 5rpx;
  color: #8d948d;
  font-size: 15rpx;
  letter-spacing: 1rpx;
}

.macro-list {
  display: flex;
  margin-top: 26rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(21, 39, 31, 0.08);
}

.macro-col {
  flex: 1;
  margin-right: 16rpx;
}

.macro-col:last-child {
  margin-right: 0;
}

.today-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(21, 39, 31, 0.08);
}

.today-note {
  max-width: 390rpx;
  color: #70786f;
  font-size: 18rpx;
  line-height: 1.6;
}

.advice-panel {
  margin-top: 22rpx;
  padding: 28rpx 24rpx 22rpx;
  border-radius: 36rpx;
  background:
    radial-gradient(circle at 100% 0%, rgba(217, 239, 124, 0.14), transparent 260rpx),
    #103126;
}

.advice-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.eyebrow-light {
  color: #d9ef7c;
}

.section-title.light {
  color: #fffdf7;
}

.coach-mark {
  display: flex;
  width: 58rpx;
  height: 58rpx;
  align-items: center;
  justify-content: center;
  color: #d9ef7c;
  border: 1rpx solid rgba(217, 239, 124, 0.2);
  border-radius: 50%;
  background: rgba(217, 239, 124, 0.08);
  font-size: 25rpx;
}

.advice-list {
  margin-top: 18rpx;
}

.advice-item {
  margin-bottom: 12rpx;
}

.advice-item:last-child {
  margin-bottom: 0;
}

.demo-note {
  display: flex;
  align-items: flex-start;
  margin-top: 14rpx;
  padding-top: 14rpx;
  color: rgba(255, 253, 247, 0.52);
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
  font-size: 17rpx;
  line-height: 1.6;
}

.demo-icon {
  margin-right: 8rpx;
  color: #d9ef7c;
}

.recent-list {
  display: flex;
  flex-direction: column;
}

.recent-card {
  display: flex;
  align-items: center;
  padding: 12rpx;
  margin-bottom: 12rpx;
  border: 1rpx solid rgba(21, 39, 31, 0.09);
  border-radius: 26rpx;
  background: #fffdf7;
  box-shadow: 0 6rpx 18rpx rgba(21, 39, 31, 0.035);
}

.recent-image-wrap {
  position: relative;
  width: 112rpx;
  height: 112rpx;
  flex: none;
  overflow: hidden;
  border-radius: 20rpx;
  background: #f8f5ea;
}

.recent-image {
  width: 100%;
  height: 100%;
}

.recent-emoji {
  display: flex;
  width: 100%;
  height: 100%;
  align-items: center;
  justify-content: center;
  background: #eef7c8;
  font-size: 44rpx;
}

.recent-type {
  position: absolute;
  bottom: 6rpx;
  left: 6rpx;
  padding: 2rpx 8rpx;
  color: #15271f;
  border-radius: 999rpx;
  background: rgba(255, 253, 247, 0.9);
  font-size: 14rpx;
  font-weight: 700;
}

.recent-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  margin-left: 16rpx;
}

.recent-time {
  color: #969c93;
  font-size: 17rpx;
}

.recent-name {
  overflow: hidden;
  margin-top: 3rpx;
  font-size: 24rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-meta {
  margin-top: 5rpx;
  color: #70786f;
  font-size: 18rpx;
}

.recent-arrow {
  margin-left: 8rpx;
  color: #969c93;
  font-size: 24rpx;
}

.starter-card {
  margin-top: 42rpx;
  padding: 26rpx;
  border: 1rpx solid rgba(21, 39, 31, 0.09);
  border-radius: 34rpx;
  background: rgba(255, 253, 247, 0.72);
}

.starter-head {
  margin-bottom: 18rpx;
}

.starter-step {
  display: flex;
  align-items: flex-start;
  padding: 18rpx 0;
  border-top: 1rpx solid rgba(21, 39, 31, 0.07);
}

.step-index {
  width: 66rpx;
  flex: none;
  color: rgba(21, 39, 31, 0.3);
  font-family: Georgia, serif;
  font-size: 31rpx;
  font-style: italic;
}

.step-copy {
  display: flex;
  flex-direction: column;
}

.step-title {
  font-size: 24rpx;
  font-weight: 700;
}

.step-body {
  margin-top: 4rpx;
  color: #70786f;
  font-size: 19rpx;
  line-height: 1.62;
}

.photo-tips {
  margin-top: 22rpx;
  padding: 22rpx 24rpx;
  border: 1rpx dashed rgba(21, 39, 31, 0.18);
  border-radius: 24rpx;
}

.tips-head {
  display: flex;
  align-items: center;
}

.tips-icon {
  display: flex;
  width: 50rpx;
  height: 50rpx;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  color: #1b4b37;
  border-radius: 50%;
  background: #eef7c8;
  font-size: 23rpx;
}

.tips-title {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
}

.tips-sub {
  display: block;
  color: #8d948d;
  font-size: 17rpx;
}

.tips-row {
  display: flex;
  flex-direction: column;
  margin-top: 14rpx;
  color: #70786f;
  font-size: 18rpx;
  line-height: 1.9;
}
