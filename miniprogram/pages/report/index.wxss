.report-page {
  padding: 26rpx 28rpx 60rpx;
}

.page-head {
  padding: 4rpx 4rpx 22rpx;
}

.page-title {
  margin-top: 10rpx;
  font-size: 60rpx;
  font-weight: 700;
  line-height: 1.06;
  letter-spacing: -4rpx;
}

.page-sub {
  max-width: 590rpx;
  margin-top: 14rpx;
  color: #70786f;
  font-size: 22rpx;
  line-height: 1.65;
}

.week-switcher {
  display: flex;
  align-items: center;
  padding: 8rpx 10rpx;
  border: 1rpx solid rgba(21, 39, 31, 0.09);
  border-radius: 999rpx;
  background: #fffdf7;
  box-shadow: 0 6rpx 18rpx rgba(21, 39, 31, 0.04);
}

.week-arrow {
  display: flex;
  width: 64rpx;
  height: 64rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  color: #15271f;
  border-radius: 50%;
  background: #f3f1e8;
  font-size: 34rpx;
  line-height: 1;
}

.week-arrow.is-disabled {
  opacity: 0.28;
}

.week-center {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.week-range {
  color: #15271f;
  font-size: 22rpx;
  font-weight: 600;
}

.week-tag {
  margin-top: 2rpx;
  padding: 2rpx 12rpx;
  color: #969c93;
  border-radius: 999rpx;
  background: #f3f1e8;
  font-size: 14rpx;
}

.week-tag.now {
  color: #1b4b37;
  background: #eef7c8;
}

.report-loading {
  display: flex;
  align-items: center;
  flex-direction: column;
  padding: 130rpx 0;
  color: #70786f;
  font-size: 21rpx;
}

.loading-dot {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 18rpx;
  border: 4rpx solid #deddcf;
  border-top-color: #1b4b37;
  border-radius: 50%;
  animation: report-spin 800ms linear infinite;
}

@keyframes report-spin {
  to {
    transform: rotate(360deg);
  }
}

.report-error {
  display: flex;
  align-items: center;
  flex-direction: column;
  padding: 100rpx 30rpx;
  text-align: center;
}

.error-title {
  color: #15271f;
  font-size: 28rpx;
  font-weight: 700;
}

.error-copy {
  max-width: 520rpx;
  margin-top: 10rpx;
  color: #70786f;
  font-size: 20rpx;
  line-height: 1.6;
}

.error-btn {
  margin-top: 20rpx;
}

.report-hero {
  margin-top: 16rpx;
  padding: 28rpx 26rpx 22rpx;
  border-radius: 36rpx;
  background:
    radial-gradient(circle at 100% 0%, rgba(217, 239, 124, 0.2), transparent 300rpx),
    #103126;
  box-shadow: 0 10rpx 26rpx rgba(16, 49, 38, 0.18);
}

.eyebrow-light {
  color: #d9ef7c;
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-date {
  color: rgba(255, 253, 247, 0.54);
  font-size: 17rpx;
}

.hero-main {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 12rpx;
}

.hero-streak {
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: flex-end;
  flex-wrap: wrap;
}

.hero-number {
  color: #d9ef7c;
  font-family: Georgia, "Songti SC", serif;
  font-size: 100rpx;
  font-weight: 600;
  line-height: 0.95;
  letter-spacing: -4rpx;
}

.hero-unit {
  margin-left: 8rpx;
  margin-bottom: 8rpx;
  color: rgba(255, 253, 247, 0.48);
  font-size: 20rpx;
}

.hero-label {
  width: 100%;
  margin-top: 6rpx;
  color: rgba(255, 253, 247, 0.52);
  font-size: 16rpx;
}

.hero-side {
  display: flex;
  width: 260rpx;
  flex: none;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 18rpx;
}

.hero-side-value {
  color: #fffdf7;
  font-family: Georgia, "Songti SC", serif;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.1;
}

.hero-side-label {
  color: rgba(255, 253, 247, 0.44);
  font-size: 15rpx;
}

.hero-side-note {
  margin-top: 8rpx;
  color: rgba(255, 253, 247, 0.7);
  font-size: 17rpx;
  line-height: 1.45;
  text-align: right;
}

.hero-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 14rpx;
  color: rgba(255, 253, 247, 0.46);
  border-top: 1rpx solid rgba(255, 255, 255, 0.09);
  font-size: 15rpx;
}

.stat-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 16rpx;
}

.stat-cell {
  display: flex;
  width: 49%;
  flex-direction: column;
  margin-bottom: 12rpx;
  padding: 22rpx 22rpx 20rpx;
  border: 1rpx solid rgba(21, 39, 31, 0.09);
  border-radius: 28rpx;
  background: #fffdf7;
  box-shadow: 0 6rpx 18rpx rgba(21, 39, 31, 0.04);
}

.stat-value {
  color: #15271f;
  font-family: Georgia, "Songti SC", serif;
  font-size: 46rpx;
  font-weight: 600;
  line-height: 1.1;
}

.stat-unit {
  margin-left: 2rpx;
  color: #969c93;
  font-family: -apple-system, sans-serif;
  font-size: 17rpx;
}

.stat-label {
  margin-top: 6rpx;
  color: #70786f;
  font-size: 17rpx;
}

.stat-sub {
  margin-top: 2rpx;
  color: #969c93;
  font-size: 14rpx;
}

.live-note {
  display: flex;
  align-items: center;
  margin-top: 4rpx;
  padding: 10rpx 16rpx;
  color: #7d6a3c;
  border-radius: 14rpx;
  background: rgba(245, 221, 160, 0.3);
  font-size: 16rpx;
  line-height: 1.5;
}

.live-dot {
  width: 10rpx;
  height: 10rpx;
  flex: none;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #d6a23f;
}

.card {
  margin-top: 16rpx;
  padding: 26rpx 24rpx;
}

.card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.chart-note {
  color: #969c93;
  font-size: 17rpx;
}

.chart {
  margin-top: 20rpx;
}

.chart-plot {
  position: relative;
  height: 212rpx;
}

.chart--protein .chart-plot {
  height: 128rpx;
}

.target-line {
  position: absolute;
  right: 0;
  left: 0;
  z-index: 1;
  border-top: 1rpx dashed rgba(237, 107, 76, 0.55);
}

.target-label {
  position: absolute;
  top: -24rpx;
  right: 0;
  z-index: 3;
  padding: 0 6rpx;
  color: #bf5238;
  background: #fffdf7;
  font-size: 14rpx;
}

.bars {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  height: 100%;
  align-items: flex-end;
}

.bar-col {
  display: flex;
  min-width: 0;
  height: 100%;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
}

.bar-value {
  height: 18rpx;
  margin-bottom: 4rpx;
  color: #70786f;
  font-size: 13rpx;
  line-height: 18rpx;
}

.bar {
  z-index: 2;
  width: 30rpx;
  border-radius: 8rpx 8rpx 4rpx 4rpx;
  background: #1b4b37;
}

.bar-off {
  background: #ece9dd;
}

.bar-on.good {
  background: #1b4b37;
}

.bar-on.high {
  background: #ed6b4c;
}

.bar-on.low {
  background: #d6a23f;
}

.bar-today {
  box-shadow: 0 0 0 4rpx rgba(217, 239, 124, 0.8);
}

.bar--protein {
  width: 26rpx;
}

.bar--protein.bar-on {
  background: #df795d;
}

.bar--protein.bar-off {
  background: #ece9dd;
}

.chart-labels {
  display: flex;
  margin-top: 8rpx;
}

.label-col {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  align-items: center;
}

.bar-day {
  color: #70786f;
  font-size: 15rpx;
}

.bar-day.is-today {
  color: #1b4b37;
  font-weight: 700;
}

.bar-date {
  margin-top: 1rpx;
  color: #a4a79f;
  font-size: 12rpx;
}

.chart-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
  padding-top: 12rpx;
  color: #969c93;
  border-top: 1rpx solid rgba(21, 39, 31, 0.07);
  font-size: 15rpx;
}

.day-list {
  margin-top: 10rpx;
}

.day-row {
  display: flex;
  align-items: center;
  padding: 15rpx 0;
  border-bottom: 1rpx solid rgba(21, 39, 31, 0.07);
}

.day-row:last-child {
  border-bottom: 0;
}

.day-row.is-today {
  margin: 0 -10rpx;
  padding-right: 10rpx;
  padding-left: 10rpx;
  border-radius: 14rpx;
  background: rgba(238, 247, 200, 0.46);
}

.day-name {
  width: 62rpx;
  flex: none;
  color: #31473b;
  font-size: 19rpx;
  font-weight: 600;
}

.day-date {
  width: 62rpx;
  flex: none;
  color: #a4a79f;
  font-size: 15rpx;
}

.day-values {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.day-kcal {
  color: #15271f;
  font-size: 19rpx;
  font-weight: 600;
}

.day-protein {
  margin-top: 1rpx;
  color: #969c93;
  font-size: 15rpx;
}

.day-empty {
  color: #a4a79f;
  font-size: 17rpx;
}

.day-state {
  flex: none;
  margin-left: 10rpx;
  padding: 4rpx 12rpx;
  color: #70786f;
  border-radius: 999rpx;
  background: #f3f1e8;
  font-size: 14rpx;
  font-weight: 600;
}

.day-state.good {
  color: #1b4b37;
  background: #eef7c8;
}

.day-state.high {
  color: #bf5238;
  background: rgba(237, 107, 76, 0.12);
}

.day-state.low {
  color: #8a641c;
  background: rgba(214, 162, 63, 0.16);
}

.compare-list {
  margin-top: 8rpx;
}

.compare-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(21, 39, 31, 0.07);
}

.compare-row:last-child {
  border-bottom: 0;
}

.compare-label {
  min-width: 0;
  flex: 1;
  color: #31473b;
  font-size: 19rpx;
}

.compare-value {
  width: 150rpx;
  flex: none;
  color: #15271f;
  font-size: 19rpx;
  font-weight: 600;
  text-align: right;
}

.compare-value.up {
  color: #1b4b37;
}

.compare-value.down {
  color: #bf5238;
}

.compare-value.flat {
  color: #70786f;
}

.compare-prev {
  width: 176rpx;
  flex: none;
  margin-left: 12rpx;
  color: #969c93;
  font-size: 15rpx;
  text-align: right;
}

.compare-empty {
  margin-top: 14rpx;
  padding: 22rpx;
  color: #70786f;
  border: 1rpx dashed #deddcf;
  border-radius: 20rpx;
  background: #f8f5ea;
  font-size: 18rpx;
  line-height: 1.6;
  text-align: center;
}

.summary-card {
  background:
    radial-gradient(circle at 100% 0%, rgba(217, 239, 124, 0.32), transparent 260rpx),
    #fffdf7;
}

.summary-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.summary-mark {
  color: #1b4b37;
  font-size: 24rpx;
}

.summary-title {
  margin-top: 10rpx;
  color: #15271f;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.3;
}

.summary-body {
  margin-top: 8rpx;
  color: #31473b;
  font-size: 20rpx;
  line-height: 1.7;
}

.tip-list {
  margin-top: 6rpx;
}

.tip-item {
  display: flex;
  padding: 16rpx 0;
  border-top: 1rpx solid rgba(21, 39, 31, 0.08);
}

.tip-item:first-child {
  border-top: 0;
}

.tip-index {
  width: 42rpx;
  flex: none;
  color: #969c93;
  font-family: Georgia, "Songti SC", serif;
  font-size: 17rpx;
  font-weight: 600;
}

.tip-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.tip-title {
  color: #15271f;
  font-size: 20rpx;
  font-weight: 700;
}

.tip-body {
  margin-top: 3rpx;
  color: #70786f;
  font-size: 18rpx;
  line-height: 1.6;
}

.empty-report {
  display: flex;
  align-items: center;
  flex-direction: column;
  padding: 40rpx 28rpx 30rpx;
  text-align: center;
}

.empty-btn {
  margin-top: 22rpx;
}

.share-card {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 22rpx 24rpx;
  border-radius: 30rpx;
  background: #15271f;
  box-shadow: 0 10rpx 24rpx rgba(21, 39, 31, 0.16);
}

.share-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.share-title {
  color: #fffdf7;
  font-size: 23rpx;
  font-weight: 700;
}

.share-sub {
  margin-top: 4rpx;
  color: rgba(255, 253, 247, 0.54);
  font-size: 17rpx;
  line-height: 1.5;
}

.share-btn {
  height: 64rpx;
  flex: none;
  margin-left: 14rpx;
  padding: 0 24rpx;
  color: #15271f;
  background: #d9ef7c;
  font-size: 21rpx;
  font-weight: 700;
}

.report-foot {
  margin-top: 18rpx;
  padding: 0 8rpx;
  color: #a4a79f;
  font-size: 15rpx;
  line-height: 1.6;
  text-align: center;
}
