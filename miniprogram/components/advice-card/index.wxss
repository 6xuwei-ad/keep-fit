.advice {
  display: flex;
  align-items: flex-start;
  padding: 22rpx;
  border: 1rpx solid rgba(21, 39, 31, 0.08);
  border-radius: 22rpx;
  background: #fffdf7;
}

.advice.compact {
  padding: 18rpx;
}

.advice-icon {
  display: flex;
  width: 54rpx;
  height: 54rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  margin-right: 14rpx;
  border-radius: 16rpx;
  background: #eef7c8;
  font-size: 26rpx;
}

.advice-copy {
  min-width: 0;
}

.advice-title {
  color: #15271f;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.4;
}

.advice-body {
  margin-top: 5rpx;
  color: #70786f;
  font-size: 20rpx;
  line-height: 1.62;
}

.advice.dark {
  border-color: rgba(255, 255, 255, 0.09);
  background: rgba(255, 255, 255, 0.06);
}

.advice.dark .advice-icon {
  background: rgba(217, 239, 124, 0.12);
}

.advice.dark .advice-title {
  color: #f8f7eb;
}

.advice.dark .advice-body {
  color: rgba(255, 253, 247, 0.62);
}
