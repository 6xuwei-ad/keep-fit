view,
text,
image {
  box-sizing: border-box;
}

.tabbar-shell {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1200;
  padding: 0 22rpx 16rpx;
  padding-bottom: calc(16rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  pointer-events: none;
}

.tabbar-glass {
  position: relative;
  display: flex;
  height: 108rpx;
  align-items: center;
  padding: 8rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  border-radius: 999rpx;
  background: rgba(255, 253, 247, 0.84);
  background:
    linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.8) 0%,
      rgba(255, 253, 247, 0.52) 48%,
      rgba(238, 247, 200, 0.36) 100%
    );
  box-shadow:
    0 18rpx 44rpx rgba(16, 49, 38, 0.2),
    0 2rpx 8rpx rgba(16, 49, 38, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.96);
  /* iOS / 新内核走真实背景模糊；不支持时上面的半透明底色仍然可读。 */
  -webkit-backdrop-filter: blur(28px) saturate(190%);
  backdrop-filter: blur(28px) saturate(190%);
  pointer-events: auto;
}

.glass-halo {
  position: absolute;
  top: -120rpx;
  right: -40rpx;
  width: 300rpx;
  height: 230rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(217, 239, 124, 0.55), transparent 68%);
  opacity: 0.72;
  pointer-events: none;
}

.glass-sheen {
  position: absolute;
  top: 0;
  left: 4%;
  width: 92%;
  height: 54%;
  border-radius: 999rpx 999rpx 44% 44%;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.66), rgba(255, 255, 255, 0));
  pointer-events: none;
}

.glass-rim {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  border-radius: inherit;
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.9),
    inset 0 -14rpx 24rpx rgba(27, 75, 55, 0.06),
    inset 8rpx 0 18rpx rgba(255, 255, 255, 0.2),
    inset -8rpx 0 18rpx rgba(255, 255, 255, 0.2);
  pointer-events: none;
}

.tab-track {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  bottom: 8rpx;
  left: 8rpx;
  border-radius: 999rpx;
}

.tab-pill {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 33.3333%;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 999rpx;
  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.86) 0%,
      rgba(245, 250, 218, 0.62) 52%,
      rgba(217, 239, 124, 0.48) 100%
    );
  box-shadow:
    0 8rpx 20rpx rgba(27, 75, 55, 0.12),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.96),
    inset 0 -8rpx 16rpx rgba(27, 75, 55, 0.05);
  transition: transform 420ms cubic-bezier(0.22, 1.12, 0.36, 1);
  z-index: 1;
}

.pill-sheen {
  position: absolute;
  top: 3rpx;
  left: 12%;
  width: 76%;
  height: 40%;
  border-radius: 50%;
  background: radial-gradient(ellipse at center, rgba(255, 255, 255, 0.94), transparent 70%);
  opacity: 0.9;
  pointer-events: none;
}

.tab-item {
  position: relative;
  z-index: 2;
  display: flex;
  height: 100%;
  flex: 1;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  transition: transform 180ms ease;
}

.tab-hover {
  transform: scale(0.94);
}

.tab-icon-wrap {
  display: flex;
  width: 50rpx;
  height: 50rpx;
  align-items: center;
  justify-content: center;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
  opacity: 0.56;
  transition:
    opacity 240ms ease,
    transform 360ms cubic-bezier(0.22, 1.12, 0.36, 1);
}

.tab-item.active .tab-icon {
  opacity: 1;
  transform: translateY(-2rpx) scale(1.06);
}

.tab-label {
  margin-top: 4rpx;
  color: #6b776d;
  font-size: 18rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  line-height: 1.2;
  transition: color 240ms ease;
}

.tab-item.active .tab-label {
  color: #1b4b37;
  font-weight: 700;
}
