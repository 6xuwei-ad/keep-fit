# ── 服务 ─────────────────────────────────────────────
PORT=8787

# ── 视觉识别（任何 OpenAI 兼容的视觉模型）──────────────
# 不填写时自动进入演示识别模式，产品可完整体验。
VISION_API_KEY=
VISION_BASE_URL=https://api.openai.com/v1
VISION_MODEL=gpt-4.1-mini
VISION_TIMEOUT_MS=45000

# 生产环境可关闭演示模式，让未配置模型时直接报错
ALLOW_DEMO=true

# ── 微信小程序登录（可选）──────────────────────────────
# 不填写时，小程序自动使用本地设备 ID，方便开发调试。
WECHAT_APPID=
WECHAT_SECRET=
# 生产环境必须改成至少 32 位的随机字符串
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_TTL_SECONDS=2592000

# ── 微信订阅消息提醒（可选）────────────────────────────
# 在微信公众平台 → 订阅消息里申请“饮食记录提醒”模板，把模板 ID 填在这里。
# 四项可以只填想用的；没填的提醒会在目标页显示“未配置模板”。
# 模板字段默认是 thing1 / time2 / thing3；不同模板的字段 key 可能不同，
# 可以全局覆盖，也可以按提醒单独覆盖：
# {"default":{"title":"thing1","time":"time2","note":"thing3"},
#  "lunch":{"title":"thing1","time":"time2","note":"thing4"}}
WECHAT_TEMPLATE_LUNCH=
WECHAT_TEMPLATE_DINNER=
WECHAT_TEMPLATE_WEEKLY=
WECHAT_TEMPLATE_STREAK=
WECHAT_REMINDER_FIELDS={"default":{"title":"thing1","time":"time2","note":"thing3"},"lunch":{"title":"thing1","time":"time2","note":"thing4"}}
# 开发版/体验版调试时改成 developer 或 trial；正式发布用 formal
WECHAT_MINIPROGRAM_STATE=formal
