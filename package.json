{
  "name": "shike-food-journal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "食刻 — 拍一张，吃明白。AI 食物识别、克数校核与营养建议小程序。",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch --experimental-strip-types server/index.ts",
    "dev:client": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "cross-env NODE_ENV=production node --experimental-strip-types server/index.ts",
    "preview": "cross-env NODE_ENV=production node --experimental-strip-types server/index.ts",
    "typecheck": "tsc --noEmit",
    "check:mini": "node scripts/check-miniprogram.mjs",
    "test": "node --experimental-strip-types --test --test-isolation=none server/tests/nutrition.test.ts server/tests/suggestions.test.ts server/tests/vision.test.ts server/tests/session.test.ts server/tests/miniprogram.test.ts server/tests/api.test.ts"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "lucide-react": "^1.66.0",
    "multer": "^2.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "postcss": "^8.5.32",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
